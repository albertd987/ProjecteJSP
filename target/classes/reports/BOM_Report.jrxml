<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
    name="BOM_Report" pageWidth="595" pageHeight="842" columnWidth="515" leftMargin="40"
    rightMargin="40" topMargin="40" bottomMargin="40">

    <!-- PARAMETERS: Dades del producte -->
    <parameter name="PRODUCT_CODE" class="java.lang.String" />
    <parameter name="PRODUCT_NAME" class="java.lang.String" />
    <parameter name="PRODUCT_DESC" class="java.lang.String" />
    <parameter name="PRODUCT_STOCK" class="java.lang.Integer" />
    <parameter name="GENERATION_DATE" class="java.util.Date" />
    <parameter name="TOTAL_COST" class="java.lang.Double" />

    <!-- FIELDS: Dades dels components (del DataSource) -->
    <field name="piItCodi" class="java.lang.String" />
    <field name="componentName" class="java.lang.String" />
    <field name="quantitat" class="java.lang.Integer" />
    <field name="unitatMesura" class="java.lang.String" />
    <field name="preuUnitat" class="java.lang.Double" />
    <field name="costTotal" class="java.lang.Double" />

    <!-- VARIABLES: Càlcul del subtotal -->
    <variable name="SUBTOTAL" class="java.lang.Double" calculation="Sum">
        <variableExpression><![CDATA[$F{costTotal}]]></variableExpression>
    </variable>

    <!-- ========================================== -->
    <!-- TITLE BAND: Logo i títol -->
    <!-- ========================================== -->
    <title>
        <band height="120">
            <!-- Nom de l'empresa -->
            <staticText>
                <reportElement x="0" y="0" width="515" height="40" />
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="24" isBold="true" />
                </textElement>
                <text><![CDATA[TALLERS MANOLO]]></text>
            </staticText>

            <!-- Subtítol -->
            <staticText>
                <reportElement x="0" y="45" width="515" height="25" />
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="16" isBold="false" />
                </textElement>
                <text><![CDATA[Bill of Materials (BOM)]]></text>
            </staticText>

            <!-- Línia separadora -->
            <line>
                <reportElement x="0" y="75" width="515" height="1" />
                <graphicElement>
                    <pen lineWidth="2.0" lineColor="#2C3E50" />
                </graphicElement>
            </line>
        </band>
    </title>

    <!-- ========================================== -->
    <!-- PAGE HEADER: Info del producte -->
    <!-- ========================================== -->
    <pageHeader>
        <band height="100">
            <!-- Codi Producte -->
            <staticText>
                <reportElement x="0" y="10" width="150" height="20" />
                <textElement>
                    <font size="10" isBold="true" />
                </textElement>
                <text><![CDATA[Codi Producte:]]></text>
            </staticText>
            <textField>
                <reportElement x="150" y="10" width="365" height="20" />
                <textElement>
                    <font size="10" />
                </textElement>
                <textFieldExpression><![CDATA[$P{PRODUCT_CODE}]]></textFieldExpression>
            </textField>

            <!-- Nom -->
            <staticText>
                <reportElement x="0" y="30" width="150" height="20" />
                <textElement>
                    <font size="10" isBold="true" />
                </textElement>
                <text><![CDATA[Nom:]]></text>
            </staticText>
            <textField>
                <reportElement x="150" y="30" width="365" height="20" />
                <textElement>
                    <font size="10" />
                </textElement>
                <textFieldExpression><![CDATA[$P{PRODUCT_NAME}]]></textFieldExpression>
            </textField>

            <!-- Descripció -->
            <staticText>
                <reportElement x="0" y="50" width="150" height="20" />
                <textElement>
                    <font size="10" isBold="true" />
                </textElement>
                <text><![CDATA[Descripció:]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement x="150" y="50" width="365" height="20" />
                <textElement>
                    <font size="10" />
                </textElement>
                <textFieldExpression><![CDATA[$P{PRODUCT_DESC} != null ? $P{PRODUCT_DESC} : "-"]]></textFieldExpression>
            </textField>

            <!-- Data de generació -->
            <staticText>
                <reportElement x="0" y="70" width="150" height="20" />
                <textElement>
                    <font size="10" isBold="true" />
                </textElement>
                <text><![CDATA[Data Generació:]]></text>
            </staticText>
            <textField pattern="dd/MM/yyyy HH:mm">
                <reportElement x="150" y="70" width="365" height="20" />
                <textElement>
                    <font size="10" />
                </textElement>
                <textFieldExpression><![CDATA[$P{GENERATION_DATE}]]></textFieldExpression>
            </textField>
        </band>
    </pageHeader>

    <!-- ========================================== -->
    <!-- COLUMN HEADER: Capçalera de la taula -->
    <!-- ========================================== -->
    <columnHeader>
        <band height="30">
            <staticText>
                <reportElement mode="Opaque" x="0" y="0" width="80" height="25" backcolor="#007BFF"
                    forecolor="#FFFFFF" />
                <box>
                    <pen lineWidth="0.5" lineColor="#FFFFFF" />
                </box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="9" isBold="true" />
                </textElement>
                <text><![CDATA[Codi]]></text>
            </staticText>

            <staticText>
                <reportElement mode="Opaque" x="80" y="0" width="150" height="25"
                    backcolor="#007BFF" forecolor="#FFFFFF" />
                <box>
                    <pen lineWidth="0.5" lineColor="#FFFFFF" />
                </box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="9" isBold="true" />
                </textElement>
                <text><![CDATA[Nom Component]]></text>
            </staticText>

            <staticText>
                <reportElement mode="Opaque" x="230" y="0" width="60" height="25"
                    backcolor="#007BFF" forecolor="#FFFFFF" />
                <box>
                    <pen lineWidth="0.5" lineColor="#FFFFFF" />
                </box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="9" isBold="true" />
                </textElement>
                <text><![CDATA[Quantitat]]></text>
            </staticText>

            <staticText>
                <reportElement mode="Opaque" x="290" y="0" width="50" height="25"
                    backcolor="#007BFF" forecolor="#FFFFFF" />
                <box>
                    <pen lineWidth="0.5" lineColor="#FFFFFF" />
                </box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="9" isBold="true" />
                </textElement>
                <text><![CDATA[UM]]></text>
            </staticText>

            <staticText>
                <reportElement mode="Opaque" x="340" y="0" width="85" height="25"
                    backcolor="#007BFF" forecolor="#FFFFFF" />
                <box>
                    <pen lineWidth="0.5" lineColor="#FFFFFF" />
                </box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="9" isBold="true" />
                </textElement>
                <text><![CDATA[Preu Unit.]]></text>
            </staticText>

            <staticText>
                <reportElement mode="Opaque" x="425" y="0" width="90" height="25"
                    backcolor="#007BFF" forecolor="#FFFFFF" />
                <box>
                    <pen lineWidth="0.5" lineColor="#FFFFFF" />
                </box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="9" isBold="true" />
                </textElement>
                <text><![CDATA[Subtotal]]></text>
            </staticText>
        </band>
    </columnHeader>

    <!-- ========================================== -->
    <!-- DETAIL BAND: Files de components -->
    <!-- ========================================== -->
    <detail>
        <band height="25">
            <!-- Codi Component -->
            <textField>
                <reportElement x="0" y="0" width="80" height="20" />
                <box leftPadding="5">
                    <pen lineWidth="0.5" lineColor="#D3D3D3" />
                </box>
                <textElement verticalAlignment="Middle">
                    <font size="9" />
                </textElement>
                <textFieldExpression><![CDATA[$F{piItCodi}]]></textFieldExpression>
            </textField>

            <!-- Nom Component -->
            <textField>
                <reportElement x="80" y="0" width="150" height="20" />
                <box leftPadding="5">
                    <pen lineWidth="0.5" lineColor="#D3D3D3" />
                </box>
                <textElement verticalAlignment="Middle">
                    <font size="9" />
                </textElement>
                <textFieldExpression><![CDATA[$F{componentName}]]></textFieldExpression>
            </textField>

            <!-- Quantitat -->
            <textField pattern="#,##0">
                <reportElement x="230" y="0" width="60" height="20" />
                <box>
                    <pen lineWidth="0.5" lineColor="#D3D3D3" />
                </box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="9" />
                </textElement>
                <textFieldExpression><![CDATA[$F{quantitat}]]></textFieldExpression>
            </textField>

            <!-- Unitat Mesura -->
            <textField>
                <reportElement x="290" y="0" width="50" height="20" />
                <box>
                    <pen lineWidth="0.5" lineColor="#D3D3D3" />
                </box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="9" />
                </textElement>
                <textFieldExpression><![CDATA[$F{unitatMesura}]]></textFieldExpression>
            </textField>

            <!-- Preu Unitari -->
            <textField pattern="#,##0.00 €">
                <reportElement x="340" y="0" width="85" height="20" />
                <box rightPadding="5">
                    <pen lineWidth="0.5" lineColor="#D3D3D3" />
                </box>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="9" />
                </textElement>
                <textFieldExpression><![CDATA[$F{preuUnitat}]]></textFieldExpression>
            </textField>

            <!-- Cost Total -->
            <textField pattern="#,##0.00 €">
                <reportElement x="425" y="0" width="90" height="20" />
                <box rightPadding="5">
                    <pen lineWidth="0.5" lineColor="#D3D3D3" />
                </box>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="9" />
                </textElement>
                <textFieldExpression><![CDATA[$F{costTotal}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <!-- ========================================== -->
    <!-- SUMMARY BAND: Total -->
    <!-- ========================================== -->
    <summary>
        <band height="60">
            <!-- Línia separadora -->
            <line>
                <reportElement x="0" y="5" width="515" height="1" />
                <graphicElement>
                    <pen lineWidth="1.5" lineColor="#2C3E50" />
                </graphicElement>
            </line>

            <!-- Etiqueta TOTAL -->
            <staticText>
                <reportElement mode="Opaque" x="340" y="15" width="85" height="30"
                    backcolor="#F0F0F0" />
                <box rightPadding="5">
                    <pen lineWidth="0.5" />
                </box>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="12" isBold="true" />
                </textElement>
                <text><![CDATA[TOTAL:]]></text>
            </staticText>

            <!-- Valor TOTAL -->
            <textField pattern="#,##0.00 €">
                <reportElement mode="Opaque" x="425" y="15" width="90" height="30"
                    backcolor="#F0F0F0" />
                <box rightPadding="5">
                    <pen lineWidth="0.5" />
                </box>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="12" isBold="true" />
                </textElement>
                <textFieldExpression><![CDATA[$P{TOTAL_COST}]]></textFieldExpression>
            </textField>
        </band>
    </summary>

</jasperReport>