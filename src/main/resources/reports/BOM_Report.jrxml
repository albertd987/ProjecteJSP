<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
    name="BOM_Report" pageWidth="595" pageHeight="842" columnWidth="515" leftMargin="40"
    rightMargin="40" topMargin="40" bottomMargin="40">

     PARAMETERS: Dades del producte 
    <parameter name="PRODUCT_CODE" class="java.lang.String" />
    <parameter name="PRODUCT_NAME" class="java.lang.String" />
    <parameter name="PRODUCT_DESC" class="java.lang.String" />
    <parameter name="PRODUCT_STOCK" class="java.lang.Integer" />
    <parameter name="GENERATION_DATE" class="java.util.Date" />
    <parameter name="TOTAL_COST" class="java.lang.Double" />
     VERSIÓ 2.1: Paràmetre per la foto del producte 
    <parameter name="PRODUCT_IMAGE_PATH" class="java.lang.String" />

     FIELDS: Dades dels components (del DataSource) 
    <field name="piItCodi" class="java.lang.String" />
    <field name="componentName" class="java.lang.String" />
    <field name="quantitat" class="java.lang.Integer" />
    <field name="unitatMesura" class="java.lang.String" />
    <field name="preuUnitat" class="java.lang.Double" />
    <field name="costTotal" class="java.lang.Double" />

     VARIABLES: Càlcul del subtotal 
    <variable name="SUBTOTAL" class="java.lang.Double" calculation="Sum">
        <variableExpression><![CDATA[$F{costTotal}]]></variableExpression>
    </variable>

     ========================================== 
     TITLE BAND: Logo i títol 
     ========================================== 
    <title>
        <band height="120">
             Nom de l'empresa 
            <staticText>
                <reportElement x="0" y="0" width="515" height="40" />
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="24" isBold="true" />
                </textElement>
                <text><![CDATA[TALLERS MANOLO]]></text>
            </staticText>

             Subtítol 
            <staticText>
                <reportElement x="0" y="45" width="515" height="25" />
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="16" isBold="false" />
                </textElement>
                <text><![CDATA[Bill of Materials (BOM)]]></text>
            </staticText>

             Línia separadora 
            <line>
                <reportElement x="0" y="80" width="515" height="1" />
                <graphicElement>
                    <pen lineWidth="2.0" lineColor="#007BFF" />
                </graphicElement>
            </line>
        </band>
    </title>

     ========================================== 
     PAGE HEADER: Informació del producte AMB FOTO 
     ========================================== 
    <pageHeader>
        <band height="130">
             VERSIÓ 2.1: Foto del producte (si existeix) 
            <image scaleImage="RetainShape" hAlign="Center" vAlign="Middle" isUsingCache="true"
                onErrorType="Blank">
                <reportElement x="0" y="5" width="100" height="100">
                    <printWhenExpression><![CDATA[$P{PRODUCT_IMAGE_PATH} != null]]></printWhenExpression>
                </reportElement>
                <box>
                    <pen lineWidth="1.0" lineColor="#CCCCCC" />
                </box>
                <imageExpression><![CDATA[$P{PRODUCT_IMAGE_PATH}]]></imageExpression>
            </image>

             Placeholder quan no hi ha foto 
            <staticText>
                <reportElement mode="Opaque" x="0" y="5" width="100" height="100"
                    backcolor="#F0F0F0">
                    <printWhenExpression><![CDATA[$P{PRODUCT_IMAGE_PATH} == null]]></printWhenExpression>
                </reportElement>
                <box>
                    <pen lineWidth="1.0" lineColor="#CCCCCC" />
                </box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="10" isItalic="true" />
                </textElement>
                <text><![CDATA[Sense foto]]></text>
            </staticText>

             Codi producte 
            <staticText>
                <reportElement x="120" y="5" width="100" height="20" />
                <textElement>
                    <font size="10" isBold="true" />
                </textElement>
                <text><![CDATA[Codi Producte:]]></text>
            </staticText>
            <textField>
                <reportElement x="220" y="5" width="295" height="20" />
                <textElement>
                    <font size="10" isBold="true" />
                </textElement>
                <textFieldExpression><![CDATA[$P{PRODUCT_CODE}]]></textFieldExpression>
            </textField>

             Nom producte 
            <staticText>
                <reportElement x="120" y="28" width="100" height="20" />
                <textElement>
                    <font size="10" isBold="true" />
                </textElement>
                <text><![CDATA[Nom:]]></text>
            </staticText>
            <textField>
                <reportElement x="220" y="28" width="295" height="20" />
                <textElement>
                    <font size="10" />
                </textElement>
                <textFieldExpression><![CDATA[$P{PRODUCT_NAME}]]></textFieldExpression>
            </textField>

             Descripció 
            <staticText>
                <reportElement x="120" y="51" width="100" height="20" />
                <textElement>
                    <font size="10" isBold="true" />
                </textElement>
                <text><![CDATA[Descripció:]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement x="220" y="51" width="295" height="20" />
                <textElement>
                    <font size="10" />
                </textElement>
                <textFieldExpression><![CDATA[$P{PRODUCT_DESC} != null ? $P{PRODUCT_DESC} : "-"]]></textFieldExpression>
            </textField>

             Stock 
            <staticText>
                <reportElement x="120" y="74" width="100" height="20" />
                <textElement>
                    <font size="10" isBold="true" />
                </textElement>
                <text><![CDATA[Stock:]]></text>
            </staticText>
            <textField>
                <reportElement x="220" y="74" width="100" height="20" />
                <textElement>
                    <font size="10" />
                </textElement>
                <textFieldExpression><![CDATA[$P{PRODUCT_STOCK}]]></textFieldExpression>
            </textField>

             Data de generació 
            <staticText>
                <reportElement x="120" y="97" width="100" height="20" />
                <textElement>
                    <font size="10" isBold="true" />
                </textElement>
                <text><![CDATA[Data Generació:]]></text>
            </staticText>
            <textField pattern="dd/MM/yyyy HH:mm">
                <reportElement x="220" y="97" width="295" height="20" />
                <textElement>
                    <font size="10" />
                </textElement>
                <textFieldExpression><![CDATA[$P{GENERATION_DATE}]]></textFieldExpression>
            </textField>
        </band>
    </pageHeader>

     ========================================== 
     COLUMN HEADER: Capçalera de la taula 
     ========================================== 
    <columnHeader>
        <band height="30">
            <staticText>
                <reportElement mode="Opaque" x="0" y="0" width="80" height="25" backcolor="#007BFF"
                    forecolor="#FFFFFF" />
                <box>
                    <pen lineWidth="0.5" lineColor="#FFFFFF" />
                </box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="9" isBold="true" />
                </textElement>
                <text><![CDATA[Codi]]></text>
            </staticText>

            <staticText>
                <reportElement mode="Opaque" x="80" y="0" width="150" height="25"
                    backcolor="#007BFF" forecolor="#FFFFFF" />
                <box>
                    <pen lineWidth="0.5" lineColor="#FFFFFF" />
                </box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="9" isBold="true" />
                </textElement>
                <text><![CDATA[Nom Component]]></text>
            </staticText>

            <staticText>
                <reportElement mode="Opaque" x="230" y="0" width="60" height="25"
                    backcolor="#007BFF" forecolor="#FFFFFF" />
                <box>
                    <pen lineWidth="0.5" lineColor="#FFFFFF" />
                </box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="9" isBold="true" />
                </textElement>
                <text><![CDATA[Quantitat]]></text>
            </staticText>

            <staticText>
                <reportElement mode="Opaque" x="290" y="0" width="50" height="25"
                    backcolor="#007BFF" forecolor="#FFFFFF" />
                <box>
                    <pen lineWidth="0.5" lineColor="#FFFFFF" />
                </box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="9" isBold="true" />
                </textElement>
                <text><![CDATA[Unitat]]></text>
            </staticText>

            <staticText>
                <reportElement mode="Opaque" x="340" y="0" width="85" height="25"
                    backcolor="#007BFF" forecolor="#FFFFFF" />
                <box>
                    <pen lineWidth="0.5" lineColor="#FFFFFF" />
                </box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="9" isBold="true" />
                </textElement>
                <text><![CDATA[Preu Unit.]]></text>
            </staticText>

            <staticText>
                <reportElement mode="Opaque" x="425" y="0" width="90" height="25"
                    backcolor="#007BFF" forecolor="#FFFFFF" />
                <box>
                    <pen lineWidth="0.5" lineColor="#FFFFFF" />
                </box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="9" isBold="true" />
                </textElement>
                <text><![CDATA[Cost Total]]></text>
            </staticText>
        </band>
    </columnHeader>

     ========================================== 
     DETAIL BAND: Files de dades 
     ========================================== 
    <detail>
        <band height="22">
             Codi 
            <textField>
                <reportElement mode="Opaque" x="0" y="0" width="80" height="20"
                    backcolor="#F8F9FA" />
                <box>
                    <pen lineWidth="0.25" lineColor="#DEE2E6" />
                </box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="8" />
                </textElement>
                <textFieldExpression><![CDATA[$F{piItCodi}]]></textFieldExpression>
            </textField>

             Nom 
            <textField>
                <reportElement mode="Opaque" x="80" y="0" width="150" height="20"
                    backcolor="#F8F9FA" />
                <box>
                    <pen lineWidth="0.25" lineColor="#DEE2E6" />
                </box>
                <textElement textAlignment="Left" verticalAlignment="Middle">
                    <font size="8" />
                    <paragraph leftIndent="5" />
                </textElement>
                <textFieldExpression><![CDATA[$F{componentName}]]></textFieldExpression>
            </textField>

             Quantitat 
            <textField>
                <reportElement mode="Opaque" x="230" y="0" width="60" height="20"
                    backcolor="#F8F9FA" />
                <box>
                    <pen lineWidth="0.25" lineColor="#DEE2E6" />
                </box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="8" />
                </textElement>
                <textFieldExpression><![CDATA[$F{quantitat}]]></textFieldExpression>
            </textField>

             Unitat 
            <textField>
                <reportElement mode="Opaque" x="290" y="0" width="50" height="20"
                    backcolor="#F8F9FA" />
                <box>
                    <pen lineWidth="0.25" lineColor="#DEE2E6" />
                </box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="8" />
                </textElement>
                <textFieldExpression><![CDATA[$F{unitatMesura}]]></textFieldExpression>
            </textField>

             Preu unitari 
            <textField pattern="#,##0.00 €">
                <reportElement mode="Opaque" x="340" y="0" width="85" height="20"
                    backcolor="#F8F9FA" />
                <box>
                    <pen lineWidth="0.25" lineColor="#DEE2E6" />
                </box>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="8" />
                    <paragraph rightIndent="5" />
                </textElement>
                <textFieldExpression><![CDATA[$F{preuUnitat}]]></textFieldExpression>
            </textField>

             Cost total 
            <textField pattern="#,##0.00 €">
                <reportElement mode="Opaque" x="425" y="0" width="90" height="20"
                    backcolor="#F8F9FA" />
                <box>
                    <pen lineWidth="0.25" lineColor="#DEE2E6" />
                </box>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="8" isBold="true" />
                    <paragraph rightIndent="5" />
                </textElement>
                <textFieldExpression><![CDATA[$F{costTotal}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

     ========================================== 
     PAGE FOOTER: Paginació 
     ========================================== 
    <pageFooter>
        <band height="25">
            <textField>
                <reportElement x="200" y="5" width="100" height="15" />
                <textElement textAlignment="Right">
                    <font size="8" />
                </textElement>
                <textFieldExpression><![CDATA["Pàgina " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
            <textField evaluationTime="Report">
                <reportElement x="300" y="5" width="100" height="15" />
                <textElement textAlignment="Left">
                    <font size="8" />
                </textElement>
                <textFieldExpression><![CDATA[" de " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

     ========================================== 
     SUMMARY BAND: Totals 
     ========================================== 
    <summary>
        <band height="80">
             Línia separadora 
            <line>
                <reportElement x="0" y="5" width="515" height="1" />
                <graphicElement>
                    <pen lineWidth="1.0" lineColor="#007BFF" />
                </graphicElement>
            </line>

             Total 
            <staticText>
                <reportElement mode="Opaque" x="290" y="15" width="135" height="30"
                    backcolor="#007BFF" forecolor="#FFFFFF" />
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="12" isBold="true" />
                </textElement>
                <text><![CDATA[COST TOTAL:]]></text>
            </staticText>

            <textField pattern="#,##0.00 €">
                <reportElement mode="Opaque" x="425" y="15" width="90" height="30"
                    backcolor="#28A745" forecolor="#FFFFFF" />
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="12" isBold="true" />
                </textElement>
                <textFieldExpression><![CDATA[$P{TOTAL_COST}]]></textFieldExpression>
            </textField>

             Nota peu 
            <staticText>
                <reportElement x="0" y="55" width="515" height="20" />
                <textElement textAlignment="Center">
                    <font size="8" isItalic="true" />
                </textElement>
                <text><![CDATA[Document generat automàticament - Tallers Manolo © 2025]]></text>
            </staticText>
        </band>
    </summary>

</jasperReport>